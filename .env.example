# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=work
DB_USER=postgres
DB_PASSWORD=

# Бот-коллектор: токен от @BotFather.
# Обязательно отключить privacy mode: @BotFather -> /setprivacy -> Disable,
# иначе бот будет видеть только адресованные ему сообщения.
COLLECTOR_BOT_TOKEN=

# Бот администратора: отдельный токен от @BotFather
ADMIN_BOT_TOKEN=
# Telegram ID администраторов через запятую
ADMIN_IDS=

# Необязательно: собирать сообщения только из этих чатов (telegram_chat_id через запятую).
# Если пусто — коллектор пишет сообщения из всех групп, куда его добавили.
COLLECTOR_CHAT_IDS=

# Необязательно: часовой пояс, в котором показывать время в выгрузках.
# В базе время всегда хранится в UTC. По умолчанию Europe/Moscow.
DISPLAY_TIMEZONE=Europe/Moscow
